# claude_visual configuration.
# Copy to .env and edit. A real environment variable always overrides these.
# Restart the receiver after changing anything the server uses.

# --- network ---------------------------------------------------------------
CLAUDE_VISUAL_PORT=8765
CLAUDE_VISUAL_HOST=0.0.0.0

# Optional stable base URL for the phone, e.g. Tailscale Serve:
#   tailscale serve --bg --https=8445 http://127.0.0.1:8765
#   CLAUDE_VISUAL_PUBLIC_URL=https://<machine>.<tailnet>.ts.net:8445
# Printed first and used for the `/vis` hint, so a changed LAN IP doesn't break
# the home-screen icon. Use https for a *.ts.net name: if any Serve port on that
# host sends HSTS, browsers refuse plain http on every port. Unset = raw IPs.
# CLAUDE_VISUAL_PUBLIC_URL=

# Pin the access token instead of using the generated server/token.txt.
# Changing it invalidates the token already saved on the phone — you'd have to
# re-open the ?k=... link once.
# CLAUDE_VISUAL_TOKEN=

# WSL only: how WSL is attached to the network — `nat` (the WSL2 default) or
# `mirrored` (Windows 11 22H2+, where WSL shares this PC's interfaces).
# bin/install.js detects this and writes it here; set it by hand only if that
# guessed wrong. Under `mirrored` the receiver runs inside WSL like on Linux;
# under `nat` it has to run on the Windows side to be reachable from the phone.
# CLAUDE_VISUAL_WSL_NET=nat

# --- pickup behaviour ------------------------------------------------------
# How far back a bare `/vis` reaches, in minutes. Anything older is listed but
# not read, which is what stops a stale photo landing in an unrelated session.
CLAUDE_VISUAL_WINDOW_MIN=30

# --- image handling --------------------------------------------------------
# Longest edge the browser resizes to before uploading. 1568 is the largest
# edge Claude actually uses; going higher just uploads pixels that get thrown away.
CLAUDE_VISUAL_MAX_EDGE=1568
CLAUDE_VISUAL_JPEG_QUALITY=0.85

CLAUDE_VISUAL_MAX_FILE_MB=25
CLAUDE_VISUAL_MAX_BODY_MB=60

# --- storage ---------------------------------------------------------------
# Names relative to the project root only. Absolute paths will not work: the
# same value must resolve for Windows node (D:\...) and WSL node (/mnt/d/...).
CLAUDE_VISUAL_INBOX_DIR=inbox
CLAUDE_VISUAL_ARCHIVE_DIR=archive
CLAUDE_VISUAL_MANIFEST=manifest.jsonl

# --- misc ------------------------------------------------------------------
# How long claim.js waits when checking whether the receiver is alive.
CLAUDE_VISUAL_HEALTH_TIMEOUT_MS=600
